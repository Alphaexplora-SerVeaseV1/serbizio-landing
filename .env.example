# Local development only. Forwards /api/* from the Vite dev server to a backend
# gateway, e.g. one started from Serbizio-backend with `npm run dev:gateway`.
VITE_API_PROXY_TARGET=http://localhost:5001

# Optional overrides. Leave blank on Vercel: vercel.json already forwards the
# sign-up route to the production backend.
VITE_API_BASE_URL=
VITE_PRIVACY_URL=
